---
import MiniShield from './MiniShield.astro';
import { trust } from '../content/site';
---
<section class="trust sec-dark keep" aria-label="Por que confiar">
  <div class="wrap trust-grid">
    {trust.map((t) => (
      <div class="trust-item">
        <MiniShield icon={t.icon} />
        <div><b>{t.title}</b><span class="t">{t.text}</span></div>
      </div>
    ))}
  </div>
</section>
