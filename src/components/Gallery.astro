---
import Icon from './Icon.astro';
import { gallery, gallerySection, links, company } from '../content/site';
---
{gallery.length > 0 && (
  <section class="section sec-dark" id="oficina" aria-labelledby="oficina-h">
    <div class="wrap">
      <div class="sec-head reveal"><h2 id="oficina-h">{gallerySection.h2}</h2></div>
      <div class="gallery">
        {gallery.map((g, i) => (
          <button type="button" data-lb={i} aria-label={`Ampliar foto: ${g.caption}`}>
            <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
      <p style="margin-top:24px"><a class="btn btn-ghost" href={links.instagram} target="_blank" rel="noopener noreferrer" data-track="click_instagram" data-origem="galeria"><Icon name="instagram" size={20} />{gallerySection.cta}</a></p>
    </div>
    <dialog class="lightbox" data-lightbox aria-label="Galeria de fotos">
      <div class="lb-in">
        <img alt="" data-lb-img />
        <div class="lb-bar">
          <button type="button" data-lb-prev aria-label="Foto anterior"><Icon name="prev" /></button>
          <span data-lb-cap aria-live="polite"></span>
          <button type="button" data-lb-next aria-label="Próxima foto"><Icon name="next" /></button>
          <button type="button" data-lb-close>Fechar</button>
        </div>
      </div>
    </dialog>
    <script type="application/json" id="gallery-data" set:html={JSON.stringify(gallery)} />
  </section>
)}
