---
import MiniShield from './MiniShield.astro';
import Icon from './Icon.astro';
import { symptoms, symptomsSection, wa } from '../content/site';
---
<section class="section sec-dark" id="sintomas" aria-labelledby="sintomas-h">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 id="sintomas-h">{symptomsSection.h2}</h2>
      <p class="lead">{symptomsSection.sub}</p>
    </div>
    <ul class="chips reveal">
      {symptoms.map((s) => (
        <li>
          <a class="chip" href={wa(s.message)} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-origem="sintoma" data-item={s.id} aria-describedby={s.warning ? `warn-${s.id}` : undefined}>
            <MiniShield icon={s.icon} />
            <span>{s.label}{s.warning && <span class="chip-warn" id={`warn-${s.id}`}>{s.warning}</span>}</span>
            <Icon name="arrow" class="go" size={20} />
          </a>
        </li>
      ))}
    </ul>
    <p class="micro reveal"><Icon name="mic" size={22} class="shrink-0" /><span>{symptomsSection.micro}</span></p>
  </div>
</section>
