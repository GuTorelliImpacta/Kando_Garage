---
import Emblem from './Emblem.astro';
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import { nav, ui, waDefault, company } from '../content/site';
interface Props { home?: boolean }
const { home = true } = Astro.props;
const prefix = home ? '' : '/';
---
<a class="skip" href="#conteudo">{ui.skip}</a>
<header class="site-header" id="topo" data-header>
  <div class="wrap header-in">
    <a class="brand" href="/" data-track="logo">
      <Emblem id="hd" class="w-9 h-auto" />
      <!-- CONFIRMAR: trocar pelo wordmark oficial (SVG) quando o cliente enviar -->
      <span class="brand-name">Kando <small>Garage</small></span>
    </a>
    <nav class="nav-links" aria-label="Principal">
      {nav.map((n) => <a href={`${prefix}${n.href}`}>{n.label}</a>)}
    </nav>
    <div class="header-actions">
      <StatusBadge variant="both" />
      <a class="btn btn-primary btn-sm hide-sm" href={waDefault} rel="noopener noreferrer" target="_blank" data-track="click_whatsapp" data-origem="header"><Icon name="whatsapp" size={20} />{ui.ctaWhatsapp}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label={ui.menuOpen} data-menu-btn>
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <div class="menu-panel" id="menu" role="dialog" aria-label="Menu" data-menu>
    {nav.map((n) => <a href={`${prefix}${n.href}`} data-menu-link>{n.label}</a>)}
    <a class="btn btn-primary btn-lg" href={waDefault} rel="noopener noreferrer" target="_blank" data-track="click_whatsapp" data-origem="menu"><Icon name="whatsapp" />{ui.ctaWhatsapp}</a>
  </div>
</header>
