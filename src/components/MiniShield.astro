---
import Icon from './Icon.astro';
interface Props { icon: string; large?: boolean }
const { icon, large = false } = Astro.props;
---
<span class:list={['mshield', { lg: large }]} aria-hidden="true">
  <svg class="sh" viewBox="0 0 48 56" fill="none"><path d="M24 2 6 8v18c0 13 8 21 18 27 10-6 18-14 18-27V8z" fill="var(--surface)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M24 2v51" stroke="currentColor" stroke-width="1" opacity=".35"/></svg>
  <Icon name={icon} class="ic" />
</span>
