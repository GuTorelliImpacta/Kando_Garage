---
import Icon from './Icon.astro';
import { ui, waDefault, links } from '../content/site';
---
<nav class="action-bar" aria-label="Ações rápidas" data-action-bar>
  <a class="wa" href={waDefault} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-origem="barra"><Icon name="whatsapp" size={22} />WhatsApp</a>
  <a href={links.tel} data-track="click_call" data-origem="barra"><Icon name="phone" size={22} />{ui.call}</a>
  <a href={links.maps} target="_blank" rel="noopener noreferrer" data-track="click_directions" data-origem="barra"><Icon name="pin" size={22} />{ui.directions}</a>
</nav>
<aside aria-label="Atalho de WhatsApp"><a class="fab" href={waDefault} target="_blank" rel="noopener noreferrer" aria-label={ui.ctaWhatsapp} data-fab data-track="click_whatsapp" data-origem="flutuante"><Icon name="whatsapp" size={30} /></a></aside>
