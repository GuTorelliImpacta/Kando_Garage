---
// Emblema "Brasão da Confiança": escudo dividido, engrenagens à esquerda, chave inglesa e
// chave de fenda cruzadas à direita. ILUSTRAÇÃO PROVISÓRIA fiel ao conceito do logo.
// CONFIRMAR: substituir pelo SVG oficial do cliente (brand/). As engrenagens são grupos
// separados (.gear-a/.gear-b/.gear-c) para animar via CSS.
interface Props { class?: string; spin?: boolean; loose?: boolean; label?: string; id: string }
const { class: cls, spin = false, loose = false, label, id } = Astro.props;
const shield = 'M100 8 18 38v78c0 54 36 86 82 108 46-22 82-54 82-108V38z';
---
<svg class:list={['emblem', { 'spin-once': spin }, cls]} viewBox="0 0 200 232" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false">
  <defs>
    <clipPath id={`${id}-l`}><rect x="0" y="0" width="100" height="232"/></clipPath>
    <clipPath id={`${id}-r`}><rect x="100" y="0" width="100" height="232"/></clipPath>
    <clipPath id={`${id}-s`}><path d={shield}/></clipPath>
  </defs>
  <g clip-path={`url(#${id}-s)`}>
    <rect width="200" height="232" fill="#3a3b3e"/>
    <rect x="100" width="100" height="232" fill="#2a2b2e"/>
    <g clip-path={`url(#${id}-l)`} fill="#e0a33a">
      <g class="gear gear-a">
        <circle cx="58" cy="80" r="23" fill="none" stroke="#e0a33a" stroke-width="9" stroke-dasharray="4.5 4.5"/>
        <circle cx="58" cy="80" r="19"/><circle cx="58" cy="80" r="7" fill="#3a3b3e"/>
      </g>
      <g class="gear gear-b">
        <circle cx="86" cy="128" r="15" fill="none" stroke="#e0a33a" stroke-width="7" stroke-dasharray="3.9 3.9"/>
        <circle cx="86" cy="128" r="12"/><circle cx="86" cy="128" r="4.5" fill="#3a3b3e"/>
      </g>
      <g class={loose ? 'gear gear-c loose' : 'gear gear-c'}>
        <circle cx="52" cy="160" r="18" fill="none" stroke="#e0a33a" stroke-width="7.5" stroke-dasharray="4.7 4.7"/>
        <circle cx="52" cy="160" r="14.5"/><circle cx="52" cy="160" r="5.5" fill="#3a3b3e"/>
      </g>
    </g>
    <g clip-path={`url(#${id}-r)`} fill="#f4f2ee">
      <g transform="rotate(42 142 118)">
        <rect x="137" y="70" width="10" height="92" rx="5"/>
        <circle cx="142" cy="66" r="15"/><rect x="138" y="46" width="8" height="18" fill="#2a2b2e"/>
      </g>
      <g transform="rotate(-42 142 118)">
        <rect x="136" y="108" width="12" height="52" rx="6" fill="#e2683a"/>
        <rect x="140" y="62" width="4" height="48" rx="2"/>
      </g>
    </g>
    <path d="M100 18v200" stroke="#f4f2ee" stroke-width="2" opacity=".55"/>
  </g>
  <path d={shield} fill="none" stroke="#f4f2ee" stroke-width="6" stroke-linejoin="round"/>
</svg>
