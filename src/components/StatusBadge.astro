---
import { hours } from '../content/site';
interface Props { variant?: 'full' | 'both'; class?: string }
const { variant = 'full', class: cls } = Astro.props;
---
<!-- Estado inicial neutro (sem JS = horário fixo). O script status-horario atualiza em tempo real. -->
{variant === 'both' ? (
  <span class:list={['status', cls]} data-status role="status">
    <span class="status-full" data-status-full>{hours.summary}</span>
    <span class="status-short" data-status-short>Horário</span>
  </span>
) : (
  <span class:list={['status', cls]} data-status role="status"><span data-status-full>{hours.summary}</span></span>
)}
