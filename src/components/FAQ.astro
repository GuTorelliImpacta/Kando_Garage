---
import { faq, faqSection } from '../content/site';
const items = faq.filter((f) => f.confirmed && f.a);
---
{items.length > 0 && (
  <section class="section sec-light" id="duvidas" aria-labelledby="duvidas-h">
    <div class="wrap">
      <div class="sec-head reveal"><h2 id="duvidas-h">{faqSection.h2}</h2></div>
      <div class="faq reveal">
        {items.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>
)}
