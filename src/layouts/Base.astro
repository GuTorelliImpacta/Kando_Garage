---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyActionBar from '../components/StickyActionBar.astro';
import { seo, company, jsonLd, faq } from '../content/site';

interface Props { title?: string; description?: string; home?: boolean; schema?: boolean; noindex?: boolean }
const { title = seo.title, description = seo.description, home = true, schema = false, noindex = false } = Astro.props;
const base = (Astro.site?.toString() ?? company.siteUrl).replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = path === '/' || path === '' ? `${base}/` : `${base}${path}`;
const faqItems = faq.filter((f) => f.confirmed && f.a);
const ld = schema ? JSON.stringify(jsonLd(base, faqItems)) : '';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#141516" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${base}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kando Garage: seu carro em boas mãos. Nota 5,0 no Google." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${base}/og.jpg`} />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <Header home={home} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyActionBar />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
