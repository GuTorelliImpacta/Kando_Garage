---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import SymptomPicker from '../components/SymptomPicker.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SplitShieldSteps from '../components/SplitShieldSteps.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import Location from '../components/Location.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import MiniShield from '../components/MiniShield.astro';
import {
  services, servicesSection, how, revision, differentials, reviews, reviewsSection, company, links, wa, waDefault, ui,
} from '../content/site';
const shownReviews = reviews.filter((r) => r.confirmed);
---
<Base schema>
  <Hero />
  <TrustBar />
  <SymptomPicker />

  <section class="section sec-dark" id="servicos" aria-labelledby="servicos-h" style="background:var(--bg-alt)">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 id="servicos-h">{servicesSection.h2}</h2>
        <p class="lead">{servicesSection.intro}</p>
      </div>
      <div class="cards">{services.map((s) => <ServiceCard s={s} />)}</div>
      <div class="more-note reveal">
        <div><b>{servicesSection.outroH}</b><p class="note">{servicesSection.outroText}</p></div>
        <a class="btn btn-primary" href={waDefault} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-origem="servico" data-item="outro"><Icon name="whatsapp" size={20} />{ui.ctaWhatsapp}</a>
      </div>
    </div>
  </section>

  <section class="section sec-dark" id="como-trabalhamos" aria-labelledby="como-h">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 id="como-h">{how.h2}</h2>
        <p class="lead">{how.intro}</p>
      </div>
      <SplitShieldSteps />
      <div class="revision reveal">
        <h3>{revision.h2}</h3>
        <p>{revision.text}</p>
        <div><a class="btn btn-ghost" href={wa(revision.message)} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-origem="revisao" data-item="revisao"><Icon name="clipboard" size={20} />{revision.cta}</a></div>
      </div>
    </div>
  </section>

  <section class="section sec-dark" id="diferenciais" aria-labelledby="dif-h" style="background:var(--bg-alt)">
    <div class="wrap">
      <div class="sec-head reveal"><h2 id="dif-h">{differentials.h2}</h2></div>
      <ul class="diffs reveal">
        {differentials.items.map((d) => (
          <li class="diff"><MiniShield icon={d.icon} /><div><h3>{d.title}</h3><p>{d.text}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section sec-light" id="avaliacoes" aria-labelledby="av-h">
    <div class="wrap">
      <div class="sec-head reveal"><h2 id="av-h">{reviewsSection.h2}</h2></div>
      <div class="rating-seal reveal">
        <div class="rating-num" data-count="5,0" aria-hidden="true">{company.rating.value}</div>
        <div>
          <span class="stars" aria-hidden="true">★★★★★</span>
          <small><span class="sr-only">Nota {company.rating.value} de 5. </span>{company.rating.count} {reviewsSection.seal}</small>
        </div>
        <div class="rating-links">
          <a class="btn btn-ghost btn-sm" href={links.mapsReviews} target="_blank" rel="noopener noreferrer">{reviewsSection.seeAll}</a>
          <a class="btn btn-primary btn-sm" href={links.writeReview} target="_blank" rel="noopener noreferrer">{reviewsSection.rate}</a>
        </div>
      </div>
      {/* CONFIRMAR autorização: sem trechos confirmados, os cards não aparecem */}
      {shownReviews.length > 0 && (
        <div class="reviews">
          <ul class="rv-track" data-rv-track>{shownReviews.map((r) => <ReviewCard r={r} />)}</ul>
          <div class="rv-nav">
            <button type="button" data-rv-prev aria-label={reviewsSection.prev}><Icon name="prev" /></button>
            <button type="button" data-rv-next aria-label={reviewsSection.next}><Icon name="next" /></button>
          </div>
        </div>
      )}
    </div>
  </section>

  <Gallery />
  <FAQ />
  <Location />
  <CtaFinal />
</Base>
