---
import Base from '../layouts/Base.astro';
import { privacy, seo, company } from '../content/site';
---
<Base title={seo.privacyTitle} description={seo.privacyDescription} home={false}>
  <section class="section sec-light">
    <div class="wrap prose">
      <h1>{privacy.title}</h1>
      <p class="lead">{privacy.intro}</p>
      <ul>{privacy.items.map((i) => <li>{i}</li>)}</ul>
      <p>{privacy.contact} <a href="#email" data-email data-track="click_email" data-origem="privacidade"><span data-email-text>kandogarage (arroba) gmail.com</span></a>.</p>
      <p class="note">{privacy.updated}</p>
    </div>
  </section>
</Base>
