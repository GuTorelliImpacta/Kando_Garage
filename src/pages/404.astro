---
import Base from '../layouts/Base.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';
import { notFound, seo, ui, waDefault } from '../content/site';
---
<Base title={seo.notFoundTitle} description={seo.notFoundDescription} home={false} noindex>
  <section class="nf sec-dark warm-glow grain">
    <div class="wrap">
      <Emblem id="nf" loose label="Emblema da Kando Garage com uma engrenagem solta" />
      <h1>{notFound.h1}</h1>
      <p class="lead">{notFound.text}</p>
      <div class="hero-cta" style="justify-content:center">
        <a class="btn btn-ghost btn-lg" href="/">{notFound.home}</a>
        <a class="btn btn-primary btn-lg" href={waDefault} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-origem="404"><Icon name="whatsapp" />{ui.ctaWhatsapp}</a>
      </div>
    </div>
  </section>
</Base>
